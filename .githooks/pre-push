#!/bin/sh

# pre-push hook: runs the unit test suite before anything is pushed.
#
# Git runs hooks from the top of the working tree. This hook is wired up via
# `core.hooksPath = .githooks` (set in package.json `prepare`).
#
# To bypass temporarily:  git push --no-verify

zero=$(git hash-object --stdin </dev/null | tr '[0-9a-f]' '0')

# A push can contain several refs. If every ref is a branch/tag deletion there
# is nothing new to test, so skip the suite.
saw_non_delete=false
while read local_ref local_oid remote_ref remote_oid; do
  if [ "$local_oid" != "$zero" ]; then
    saw_non_delete=true
  fi
done

if [ "$saw_non_delete" = false ]; then
  echo "pre-push: nothing to test (only ref deletions)."
  exit 0
fi

echo "pre-push: running unit tests..."

root=$(cd "$(dirname "$0")/.." && pwd)

# Prefer `pnpm test`; fall back to the local vitest binary if pnpm is not on PATH.
if command -v pnpm >/dev/null 2>&1; then
  pnpm test
else
  "$root/node_modules/.bin/vitest" run
fi
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "pre-push: unit tests FAILED — push aborted."
  echo "          Fix the failures and retry, or bypass with: git push --no-verify"
  exit 1
fi

echo "pre-push: unit tests passed."
exit 0
